    <!-- Quick start -->
    <string name="guide_welcome_title">Welcome to Kilometerbuch</string>
    <string name="guide_welcome_text">Keep track of how much you drive, what fuel costs you and when inspection and service are due. All data stays on your phone.</string>
    <string name="guide_trips_title">Mileage</string>
    <string name="guide_trips_text">Once a month, enter how many kilometres you drove and, if you like, your fuel consumption. The charts show you the trend.</string>
    <string name="guide_fuel_title">Fuel and maintenance</string>
    <string name="guide_fuel_text">Enter the litres and the amount from your fuel receipt. The app works out the price per litre. You can record garage bills as well.</string>
    <string name="guide_menu_title">Reminders and menu</string>
    <string name="guide_menu_text">In the menu at the top right you find reminders for inspection, service and tyre changes, more cars, backup as a CSV file, dark mode and the language.</string>
    <string name="first_car_title">Your first car</string>
    <string name="first_car_text">Give it a name. You can add the odometer reading and year later; the odometer helps with the service reminder.</string>
    <string name="lets_go">Let’s go</string>
    <string name="load_csv">Load data from a CSV file</string>
    <string name="load_csv_hint">For example a backup you downloaded from the menu earlier.</string>
    <string name="step_of">Step %1$d of %2$d</string>

